# Copiar este archivo a .env y completar valores reales antes de levantar el sistema.
# Nunca commitear el .env real al repositorio.

POSTGRES_USER=dispatch_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dispatch_db

DATABASE_URL=postgresql+psycopg://dispatch_user:CHANGE_ME@postgres:5432/dispatch_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Producción (Fase 18) — dominio real usado por Nginx/Let's Encrypt.
# En desarrollo local no se usa (Nginx solo corre en docker-compose.prod.yml).
DOMAIN=despacho.tuempresa.cl

# Nota: usar dominios de email reales o no reservados en datos de prueba —
# .local, .test, .invalid son rechazados por la validación de email (ver Fase 3).

# Requeridas en fases posteriores (mapas, rutas, notificaciones):
# MAPS_API_KEY=              # obtener en el proveedor de mapas elegido (Fase 9)
# OSRM_URL=                  # URL de tu instancia OSRM/OpenRouteService/GraphHopper (Fase 7)
#
# FCM_CREDENTIALS=./secrets/firebase-adminsdk.json
#   Ruta al archivo JSON de la cuenta de servicio de Firebase (NO una clave corta).
#   Se obtiene en Firebase Console > Configuración del proyecto > Cuentas de
#   servicio > "Generar nueva clave privada". Nunca commitear ese archivo al
#   repositorio — agrégalo a .gitignore si lo copias dentro del proyecto.
#   Sin esta variable, el sistema funciona igual pero las notificaciones push
#   solo se registran en el log del backend (no se envían de verdad) — ver
#   app/services/push_service.py para el detalle completo.
